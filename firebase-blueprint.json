{
  "entities": {
    "special_attendance_event": {
      "title": "Special Attendance Event",
      "description": "Institutional and union duty attendance orders forwarded by HOD and sanctioned by Principal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the special attendance order"
        },
        "title": {
          "type": "string",
          "description": "Event or activity title"
        },
        "description": {
          "type": "string",
          "description": "Detailed description or circular memo"
        },
        "eventType": {
          "type": "string",
          "description": "Type of event",
          "enum": [
            "UNION_PROGRAMME",
            "POLITICAL_UNION",
            "COLLEGE_PROGRAMME",
            "SPORTS",
            "NSS",
            "NCC",
            "CULTURAL",
            "SEMINAR",
            "OFFICIAL_EVENT",
            "STRIKE",
            "DEPARTMENT_PROGRAMME",
            "EXAM_DUTY",
            "OTHER"
          ]
        },
        "eventDate": {
          "type": "string",
          "description": "Date of event (YYYY-MM-DD)"
        },
        "periodIds": {
          "type": "array",
          "description": "Target timetable period IDs"
        },
        "isFullDay": {
          "type": "boolean",
          "description": "Whether duty covers the entire college day"
        },
        "scopeType": {
          "type": "string",
          "description": "Target scope",
          "enum": ["COLLEGE", "DEPARTMENT", "PROGRAMME", "BATCH", "COURSE_GROUP", "SELECTED_STUDENTS"]
        },
        "departmentId": {
          "type": "string",
          "description": "Department ID if scope is departmental"
        },
        "studentCoverage": {
          "type": "string",
          "description": "Coverage mode: ALL_ELIGIBLE or SELECTED_ONLY",
          "enum": ["ALL_ELIGIBLE", "SELECTED_ONLY"]
        },
        "selectedStudentIds": {
          "type": "array",
          "description": "List of student IDs participating in the event"
        },
        "reason": {
          "type": "string",
          "description": "Official justification for duty attendance"
        },
        "dutyCertificateRef": {
          "type": "string",
          "description": "Union duty certificate or delegation memo reference"
        },
        "forwardedByHodId": {
          "type": "string",
          "description": "ID of HOD who verified duty slip and forwarded"
        },
        "forwardedByHodName": {
          "type": "string",
          "description": "Display name of HOD who forwarded request"
        },
        "forwardedAt": {
          "type": "string",
          "description": "ISO timestamp when forwarded to Principal"
        },
        "principalRemarks": {
          "type": "string",
          "description": "Official remarks by Principal upon sanctioning"
        },
        "principalActionAt": {
          "type": "string",
          "description": "ISO timestamp of Principal action"
        },
        "approvedBy": {
          "type": "string",
          "description": "Faculty ID of approving authority"
        },
        "approvedByName": {
          "type": "string",
          "description": "Name of approving authority"
        },
        "status": {
          "type": "string",
          "description": "Workflow status",
          "enum": ["PENDING_PRINCIPAL", "APPROVED", "REJECTED", "APPLIED", "DRAFT"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "eventType", "eventDate", "scopeType", "reason", "status", "createdAt"]
    },
    "announcement": {
      "title": "College Announcement",
      "description": "Official digital notice board announcements and academic circulars",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "title": {
          "type": "string",
          "description": "Notice headline"
        },
        "content": {
          "type": "string",
          "description": "Notice content body"
        },
        "authorId": {
          "type": "string",
          "description": "User ID of author"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of author"
        },
        "authorRole": {
          "type": "string",
          "description": "Role of notice issuer",
          "enum": ["PRINCIPAL", "HOD", "TEACHER", "SUPER_ADMIN"]
        },
        "departmentId": {
          "type": "string",
          "description": "Department ID if department circular"
        },
        "targetAudience": {
          "type": "string",
          "description": "Audience filter",
          "enum": ["ALL", "STUDENTS", "FACULTY", "DEPARTMENT"]
        },
        "priority": {
          "type": "string",
          "description": "Urgency",
          "enum": ["NORMAL", "IMPORTANT", "URGENT"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO publication timestamp"
        }
      },
      "required": ["id", "title", "content", "authorName", "authorRole", "targetAudience", "createdAt"]
    },
    "push_notification": {
      "title": "Push Broadcast Notification",
      "description": "Campus-wide real-time push alert dispatched by authorities",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID"
        },
        "title": {
          "type": "string",
          "description": "Alert title"
        },
        "body": {
          "type": "string",
          "description": "Notification message text"
        },
        "senderRole": {
          "type": "string",
          "description": "Role of the broadcasting authority",
          "enum": ["PRINCIPAL", "HOD", "SUPER_ADMIN"]
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender"
        },
        "targetAudience": {
          "type": "string",
          "description": "Target audience group",
          "enum": ["ALL_CAMPUS", "ALL_STUDENTS", "ALL_FACULTY", "ALL_HODS", "MY_DEPARTMENT", "DEPARTMENT_STUDENTS", "DEPARTMENT_FACULTY", "SPECIFIC_DEPARTMENT"]
        },
        "priority": {
          "type": "string",
          "description": "Priority",
          "enum": ["NORMAL", "HIGH", "EMERGENCY"]
        },
        "category": {
          "type": "string",
          "description": "Category",
          "enum": ["GENERAL", "ACADEMIC", "EXAM", "EMERGENCY", "EVENT", "MAINTENANCE"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "title", "body", "senderRole", "senderName", "targetAudience", "priority", "category", "createdAt"]
    },
    "student_attendance_summary": {
      "title": "Student Attendance Summary Rollup",
      "description": "Aggregated attendance document per student for ultra-low read quota usage on free plans",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "description": "Student primary ID"
        },
        "rollNumber": {
          "type": "string",
          "description": "Class roll number"
        },
        "admissionNumber": {
          "type": "string",
          "description": "College admission number"
        },
        "fullName": {
          "type": "string",
          "description": "Student full name"
        },
        "regularPercentage": {
          "type": "number",
          "description": "Regular academic attendance percentage"
        },
        "consolidatedPercentage": {
          "type": "number",
          "description": "Consolidated attendance percentage with sanctioned special duty"
        },
        "totalConducted": {
          "type": "number",
          "description": "Total conducted class periods"
        },
        "totalPresent": {
          "type": "number",
          "description": "Total regular present periods"
        },
        "specialDutyApprovedCount": {
          "type": "number",
          "description": "Count of principal-sanctioned union duty periods"
        },
        "specialDutyPendingCount": {
          "type": "number",
          "description": "Count of pending union duty periods"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last summary calculation"
        }
      },
      "required": ["studentId", "rollNumber", "regularPercentage", "consolidatedPercentage", "totalConducted", "lastUpdated"]
    },
    "google_account_link": {
      "title": "Google Account Link",
      "description": "Mapping between Google Auth email and NSS College student or faculty profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique sanitized identifier for the Google link"
        },
        "email": {
          "type": "string",
          "description": "Google email address"
        },
        "userType": {
          "type": "string",
          "description": "User type",
          "enum": ["STUDENT", "STAFF", "SUPER_ADMIN"]
        },
        "profileId": {
          "type": "string",
          "description": "Linked student ID or faculty ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of student or faculty"
        },
        "identifier": {
          "type": "string",
          "description": "University register number or staff employee ID"
        },
        "linkedAt": {
          "type": "string",
          "description": "ISO timestamp when account was linked"
        }
      },
      "required": ["id", "email", "userType", "profileId", "linkedAt"]
    }
  },
  "firestore": {
    "/special_attendance_events/{eventId}": {
      "schema": "special_attendance_event",
      "description": "Duty attendance orders submitted by HODs and sanctioned by Principal"
    },
    "/announcements/{announcementId}": {
      "schema": "announcement",
      "description": "Official college notice board announcements"
    },
    "/push_notifications/{notificationId}": {
      "schema": "push_notification",
      "description": "Real-time push alerts broadcast by Principal, HOD, or Super Admin"
    },
    "/student_attendance_summaries/{studentId}": {
      "schema": "student_attendance_summary",
      "description": "Pre-aggregated attendance ledger document per student allowing ~400 students to read within free tier limits for decades"
    },
    "/google_account_links/{linkId}": {
      "schema": "google_account_link",
      "description": "Persistent Google Sign-In links mapping Google email to student or staff profile"
    }
  }
}
