rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidGoogleAccountLink(data) {
      return data.keys().hasAll(['id', 'email', 'userType', 'profileId', 'linkedAt'])
        && data.keys().hasOnly(['id', 'email', 'userType', 'profileId', 'name', 'identifier', 'linkedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && data.userType is string && (
          data.userType == 'STUDENT' ||
          data.userType == 'STAFF' ||
          data.userType == 'SUPER_ADMIN'
        )
        && data.profileId is string && data.profileId.size() > 0 && data.profileId.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('identifier' in data) || (data.identifier is string && data.identifier.size() <= 128))
        && data.linkedAt is string && data.linkedAt.size() > 0 && data.linkedAt.size() <= 64;
    }

    // Special Attendance Events Collection
    // Authoritative CRUD and approvals are enforced in PostgreSQL via RLS & server sessions.
    // Client-side Firestore writes/deletes are disabled to prevent unprivileged tampering.
    match /special_attendance_events/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Announcements Collection
    // Authoritative CRUD is enforced in PostgreSQL via RLS & server sessions.
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Push Notifications Collection
    // Client-side broadcasts cannot write directly to Firestore without server admin verification.
    match /push_notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Student Attendance Summaries Collection
    // Locked down completely to prevent PII / attendance enumeration and quota abuse.
    match /student_attendance_summaries/{studentId} {
      allow get, list, create, update, delete: if false;
    }

    // Google Account Links Collection
    // Strictly isolated to the verified Google account owner; collection listing is forbidden.
    match /google_account_links/{linkId} {
      allow get: if isSignedIn() && existing().email == request.auth.token.email;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(linkId)
        && isValidGoogleAccountLink(incoming())
        && incoming().email == request.auth.token.email;
      allow update: if isSignedIn()
        && isValidId(linkId)
        && isValidGoogleAccountLink(incoming())
        && incoming().email == request.auth.token.email
        && existing().email == request.auth.token.email
        && incoming().profileId == existing().profileId
        && incoming().userType == existing().userType;
      allow delete: if isSignedIn() && existing().email == request.auth.token.email;
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
